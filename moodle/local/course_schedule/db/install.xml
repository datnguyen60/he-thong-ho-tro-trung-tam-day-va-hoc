<?xml version="1.0" encoding="UTF-8" ?>
<XMLDB PATH="local/course_schedule/db" VERSION="2025050500" COMMENT="XMLDB file for local_course_schedule" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance">
    <TABLES>
        <TABLE NAME="course_schedule" COMMENT="Course schedule per course">
            <FIELDS>
                <FIELD NAME="id" TYPE="int" LENGTH="10" NOTNULL="true" SEQUENCE="true"/>
                <FIELD NAME="sectionid" TYPE="int" LENGTH="10" NOTNULL="true"/> <!-- Liên kết tới course_sections -->
                <FIELD NAME="classdate" TYPE="char" LENGTH="10" NOTNULL="true" COMMENT="YYYY-MM-DD"/>
                <FIELD NAME="classbegintime" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="HH:MM"/>
                <FIELD NAME="classendtime" TYPE="int" LENGTH="10" NOTNULL="true" COMMENT="HH:MM"/>
                <FIELD NAME="createtime" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="lastmodifytime" TYPE="int" LENGTH="10" NOTNULL="true"/>
                <FIELD NAME="createuserid" TYPE="int" LENGTH="10" NOTNULL="true"/> <!-- Người tạo -->
                <FIELD NAME="modifyuserid" TYPE="int" LENGTH="10" NOTNULL="true"/> <!-- Người sửa cuối -->
                <FIELD NAME="ismakeup" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" COMMENT="1: makeup, 0: normal"/>
                <FIELD NAME="iscancel" TYPE="int" LENGTH="1" NOTNULL="true" DEFAULT="0" COMMENT="1: cancel, 0: normal"/>
            </FIELDS>
            <KEYS>
                <KEY NAME="primary" TYPE="primary" FIELDS="id"/>
                <KEY NAME="section_fk" TYPE="foreign" FIELDS="sectionid" REFTABLE="course_sections" REFFIELDS="id"/>
                <KEY NAME="createuser_fk" TYPE="foreign" FIELDS="createuserid" REFTABLE="user" REFFIELDS="id"/>
                <KEY NAME="modifyuser_fk" TYPE="foreign" FIELDS="modifyuserid" REFTABLE="user" REFFIELDS="id"/>
            </KEYS>
        </TABLE>
    </TABLES>
</XMLDB>